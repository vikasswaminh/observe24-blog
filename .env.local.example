# Copy this to .env.local (gitignored) and fill in real values.
# Source: https://dash.cloudflare.com/profile/api-tokens
#
# Token needs ONE permission only:
#   Account → Cloudflare Pages → Edit
#
# Scope it to your single account. Set a TTL if you want a self-revoking token.

CLOUDFLARE_API_TOKEN=cfat_replace_me
CLOUDFLARE_ACCOUNT_ID=replace_with_your_account_id
