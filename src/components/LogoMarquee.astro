---
import { INTEGRATIONS, MARQUEE_IDS } from '../data/integrations';

interface Props {
  /** Optional eyebrow shown above the strip. */
  label?: string;
}
const { label = 'Works with the stack you already run' } = Astro.props;

const raws = import.meta.glob('../icons/logos/*.svg', { query: '?raw', import: 'default', eager: true });
const items = MARQUEE_IDS
  .map((id) => INTEGRATIONS.find((i) => i.id === id))
  .filter((i): i is (typeof INTEGRATIONS)[number] => Boolean(i && i.logo))
  .map((i) => ({ name: i.name, svg: raws[`../icons/logos/${i.logo}.svg`] as string | undefined }))
  .filter((i) => i.svg);

// Duplicate the row so the CSS marquee can loop seamlessly.
const loop = [...items, ...items];
---
<section class="marquee-wrap">
  <div class="container">
    <a href="/integrations" class="marquee-label mono">{label} <span class="arr">→</span></a>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {loop.map((i) => (
        <span class="marquee-logo" title={i.name}><Fragment set:html={i.svg} /></span>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-wrap { padding: 28px 0 40px; overflow: hidden; }
  .marquee-label {
    display: inline-block;
    color: var(--ink-2);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: 22px;
  }
  .marquee-label:hover { color: var(--ink-1); }
  .marquee { position: relative; width: 100%; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .marquee-track { display: inline-flex; align-items: center; gap: 56px; animation: marquee 42s linear infinite; will-change: transform; }
  .marquee-logo { display: inline-flex; align-items: center; color: var(--ink-2); flex: 0 0 auto; transition: color 0.15s ease; }
  .marquee-logo:hover { color: var(--ink); }
  .marquee-logo :global(svg) { width: 30px; height: 30px; display: block; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; flex-wrap: wrap; gap: 32px; }
  }
</style>
