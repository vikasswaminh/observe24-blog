---
/**
 * Reusable FAQ accordion block for marketing/docs/blog pages.
 * - Interactive expand/collapse (+ / - toggle) for FAQ items.
 * - Answers are hidden by default and expand on click.
 * - Emits valid FAQPage JSON-LD schema for SEO.
 */
interface FaqItem { q: string; a: string }
interface Props { items: FaqItem[] }
const { items } = Astro.props;

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: it.a.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim(),
    },
  })),
};
---

<div class="faq-accordion-list">
  {items.map((it) => (
    <details class="faq-accordion-item">
      <summary class="faq-accordion-summary">
        <span class="faq-question-text">{it.q}</span>
        <span class="faq-toggle-badge" aria-label="Toggle answer">
          <span class="faq-plus-symbol"></span>
        </span>
      </summary>
      <div class="faq-answer-content" set:html={it.a}></div>
    </details>
  ))}
</div>

<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />

<style>
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    margin-top: 8px;
  }

  .faq-accordion-item {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 20px 24px;
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .faq-accordion-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(0, 224, 138, 0.4);
  }

  .faq-accordion-item[open] {
    background: rgba(0, 224, 138, 0.04);
    border-color: rgba(0, 224, 138, 0.5);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .faq-accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    user-select: none;
    list-style: none;
    outline: none;
  }

  .faq-accordion-summary::-webkit-details-marker,
  .faq-accordion-summary::marker {
    display: none;
    content: "";
  }

  .faq-question-text {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink, #ffffff);
    line-height: 1.5;
    flex: 1;
    transition: color 0.2s ease;
  }

  .faq-accordion-item:hover .faq-question-text,
  .faq-accordion-item[open] .faq-question-text {
    color: #2A680D;
  }

  .faq-toggle-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 224, 138, 0.12);
    border: 1px solid rgba(0, 224, 138, 0.25);
    color: #2A680D;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .faq-accordion-item:hover .faq-toggle-badge {
    background: rgba(0, 224, 138, 0.25);
    color: #2A680D;
    border-color: #2A680D;
    transform: scale(1.08);
  }

  .faq-accordion-item[open] .faq-toggle-badge {
    background: #2A680D;
    color: #0d131f;
    border-color: #2A680D;
  }

  .faq-plus-symbol {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .faq-plus-symbol::after {
    content: "+";
  }

  .faq-accordion-item[open] .faq-plus-symbol::after {
    content: "−";
  }

  .faq-answer-content {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink-2, #d1d5db);
    animation: faqFadeIn 0.25s ease-in-out;
  }

  @keyframes faqFadeIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

