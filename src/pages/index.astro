---
import Base from '../layouts/Base.astro';

const BLOG_POSTS = [
  {
    title: "What Is Observability? The Complete Guide (2026)",
    description: "What is observability, really, and how is it different from monitoring? This complete guide breaks down the three pillars, why they're not enough on their own, and how modern teams are using AI to investigate incidents instead of just detecting them.",
    category: "MONITORING & OBSERVABILITY",
    date: "2026-08-25",
    readTime: "21 MIN READ",
    link: "/blog/what-is-observability-guide-2026",
    tag: "NEW"
  },
  {
    title: "Best Datadog Alternatives in 2026 (And How to Actually Pick One)",
    description: "Datadog's bill finally caught up with your infrastructure. Here's an honest, no-fluff look at the strongest Datadog alternatives in 2026 — what each one is good at, where it falls short, and how to figure out which one fits your team instead of just the next vendor's sales deck.",
    category: "TOOL COMPARISONS",
    date: "2026-08-24",
    readTime: "20 MIN READ",
    link: "/blog/best-datadog-alternatives-2026",
    tag: "POPULAR"
  },
  {
    title: "What Is Uptime Monitoring? The Complete Guide (2026 Edition)",
    description: "Uptime monitoring explained from first principles — what it actually checks, why \"200 OK\" can still mean your site is broken, and how to build a monitoring setup that catches outages before your customers do.",
    category: "OBSERVABILITY & DEVOPS",
    date: "2026-08-20",
    readTime: "20 MIN READ",
    link: "/blog/what-is-uptime-monitoring-guide",
    tag: "FEATURED"
  },
  {
    title: "Best Uptime Monitoring Tools in 2026: The Complete Guide for Teams That Can't Afford Downtime",
    description: "Looking for the best uptime monitoring tool in 2026? We break down 10 platforms — including 24Observe, Better Stack, UptimeRobot, Pingdom, and Datadog — so you can pick the right one for your stack, budget, and team.",
    category: "MONITORING & OBSERVABILITY",
    date: "2026-08-20",
    readTime: "20 MIN READ",
    link: "/blog/best-uptime-monitoring-tools-2026",
    tag: "POPULAR"
  },
  {
    title: "We shipped the first observability API designed for AI agents — here is what changed",
    description: "Most observability APIs were built for humans clicking a dashboard, then handed to agents as a courtesy. We rebuilt ours for the case where the caller is a Claude/GPT tool call that has 300 ms to make a decision.",
    category: "PRODUCT",
    date: "2026-05-23",
    readTime: "14 MIN READ",
    link: "/blog/observability-api-for-ai-agents",
    tag: "GUIDE"
  },
  {
    title: "The 9 best BetterStack alternatives in 2026 (honest comparison)",
    description: "A genuinely useful comparison of BetterStack alternatives in 2026. Pricing, fit, and the one question to ask before you switch — written by people who respect what BetterStack built.",
    category: "MONITORING COMPARISON",
    date: "2026-05-16",
    readTime: "15 MIN READ",
    link: "/blog/betterstack-alternative",
    tag: "COMPARISON"
  },
  {
    title: "The 8 best UptimeRobot alternatives in 2026 (honest comparison)",
    description: "A genuinely useful comparison of UptimeRobot alternatives for 2026. Pricing, fit, and the honest question to ask before you switch — by people who respect what UptimeRobot built.",
    category: "MONITORING COMPARISON",
    date: "2026-05-16",
    readTime: "14 MIN READ",
    link: "/blog/uptimerobot-alternative",
    tag: "COMPARISON"
  },
  {
    title: "How to monitor a cron job in 2026 (without losing a night's sleep)",
    description: "A complete 2026 guide to cron job monitoring — covering classic cron, systemd timers, Kubernetes CronJobs, GitHub Actions, Vercel and Cloudflare cron. Honest tool comparison and a working 3-minute setup.",
    category: "CRON JOB MONITORING",
    date: "2026-05-15",
    readTime: "14 MIN READ",
    link: "/blog/monitor-cron-jobs-2026",
    tag: "GUIDE"
  },
  {
    title: "Why Your TLS Monitoring Can't Wait: The Cost of Expired Certificates",
    description: "Expired TLS certificates cost millions annually. Learn how to stop them before they bring down production.",
    category: "BEST PRACTICES",
    date: "2026-05-06",
    readTime: "8 MIN READ",
    link: "/blog/why-tls-monitoring-matters",
    tag: "SECURITY"
  }
];
---
<Base
  title="24Observe Blog"
  activeNav="blog"
  description="Guides, tips, and engineering posts from the 24Observe team."
>
  {/* HERO HEADER */}
  <section class="section" style="padding: 64px 0 40px 0;">
    <div class="container">
      <div class="eyebrow"><span class="bar"></span> Blog &amp; Guides</div>
      <h1 class="h1" style="font-size: 2.8rem; font-weight: 800;">24Observe Blog</h1>
      <p class="lede" style="margin-top: 16px; max-width: 760px;">
        In-depth guides, architecture breakdowns, uptime tool comparisons, and engineering posts from the 24Observe team.
      </p>
    </div>
  </section>

  {/* DIRECT BLOG POSTS GRID SECTION */}
  <section class="section section-alt" style="padding: 64px 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 28px; width: 100%;">
        {BLOG_POSTS.map((post) => (
          <a
            href={post.link}
            style="display: flex; flex-direction: column; justify-content: space-between; background: #0b0f19; border: 1px solid #1f2937; border-radius: 16px; padding: 28px; text-decoration: none; transition: all 0.25s ease;"
            class="blog-post-card"
          >
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
                <span style="font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #a855f7;">
                  {post.category}
                </span>
                {post.tag && (
                  <span style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-size: 0.7rem; font-weight: 800; padding: 3px 10px; border-radius: 8px; text-transform: uppercase;">
                    {post.tag}
                  </span>
                )}
              </div>
              <h3 style="font-size: 1.25rem; font-weight: 700; line-height: 1.4; color: #ffffff; margin: 0 0 12px 0;">
                {post.title}
              </h3>
              <p style="font-size: 0.92rem; line-height: 1.6; color: #9ca3af; margin: 0 0 24px 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {post.description}
              </p>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.75rem; font-weight: 700; color: #6b7280; letter-spacing: 0.06em; text-transform: uppercase; padding-top: 16px; border-top: 1px solid rgba(255,255,255,0.06); margin-top: auto;">
              <span>{post.readTime}</span>
              <span>{post.date}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .blog-post-card:hover {
      border-color: rgba(168, 85, 247, 0.6) !important;
    }
  </style>
</Base>
