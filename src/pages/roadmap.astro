---
import Base from '../layouts/Base.astro';

// Public roadmap. Mirrors the "Ship next" + active-tier sections of
// ROADMAP.md in the repo, but written for prospects, not engineers.
// What we ship vs what's on the list vs what's deferred.
//
// Convention used elsewhere on the site: never disclose internal infra,
// no internal hostnames or worker names. Talk about capabilities only.

const JUST_SHIPPED = {
  title: 'Shipped this week',
  blurb:
    "Every item below is live in production right now. Mint a token, click around, prove it works.",
  items: [
    {
      name: 'Multi-region monitoring',
      why: 'A check from one region briefly failing was opening false incidents. Now an incident only opens when consensus says down. Five regions: Western Europe, Eastern Europe, Eastern North America, Asia Pacific, Oceania.',
    },
    {
      name: 'Public platform status page',
      why: 'We monitor our own API, dashboard, and marketing site with 24Observe and publish the page so you can see if our service is up before you sign in. status.24observe.com.',
    },
    {
      name: 'Auto-extracted log facets',
      why: 'Every primitive JSON field in your log attrs becomes a click-to-filter chip in the sidebar. No schema to declare. The thing that turns "we have logs" into "we have observability".',
    },
    {
      name: 'Pattern grouping',
      why: 'Click "Patterns" on the Logs page. 10,000 lines that differ only by a timestamp and a request ID collapse to one row with the template, the sample, and the count. The single biggest reason teams stay on Datadog — now here.',
    },
    {
      name: 'Error tracking',
      why: 'Recurring stack traces auto-group by signature. JavaScript, Python, Java, Go, generic ERROR/FATAL. Same logical error across different deploys, paths, line numbers — same row. Bundles the thing Sentry charges a separate seat for.',
    },
    {
      name: 'Log-derived metrics',
      why: 'Save any log search as a time-series. Chartable, alertable, auto-refreshing every 60 seconds. Datadog charges 10¢ per metric per month for this. Here it is free.',
    },
    {
      name: 'Anomaly alerts on log volume',
      why: 'Threshold alerts when you know the magic number. Anomaly alerts when "normal" varies. Compares current window vs 7-day rolling baseline, fires at 3× spike. No ML configuration, no model tuning.',
    },
    {
      name: 'CloudWatch + Heroku + Vercel + Docker + journald',
      why: 'Four new "no SDK to install" sources land in one paste. Lambda logs flow through Kinesis Firehose. Heroku in one drains:add. Vercel in one URL. Docker containers via the syslog driver. systemd via journald. Twelve sources total now.',
    },
  ],
};

const SHIPPING_NOW = {
  title: 'Shipping in the next two weeks',
  blurb:
    "Still on the bench. Comparison-shoppers expect these when evaluating us against the incumbents. Each item has a concrete LOC/hour estimate in the public repo.",
  items: [
    {
      name: 'Import wizard — BetterStack, UptimeRobot, Pingdom',
      why: 'Paste your existing API key. We pull your monitors, map the schema, create them here. ~5 minutes per source.',
    },
    {
      name: '60-second first-monitor onboarding',
      why: 'Register, fill one form, watch a check fire. We measured: today this takes most people 3-5 minutes.',
    },
    {
      name: 'Edge rate limit on the public API',
      why: 'Tighter abuse protection without changing the per-PAT daily caps customers already control.',
    },
    {
      name: 'Faster dashboard first load',
      why: 'Splitting the 522KB single bundle into per-route chunks. Brings first-paint under 1s on a mid-range phone.',
    },
    {
      name: 'PagerDuty / Opsgenie / SMS / voice for log alerts',
      why: 'Monitor alerts already route to all ten channels. Log alerts today only route to email, Slack, Discord, Teams, Telegram, and signed webhooks — missing pager + SMS + voice. Migration to add four columns + tick-path update to enqueue them. ~4h work.',
    },
  ],
};

const NEXT_UP = {
  title: 'Next up (~4 weeks)',
  items: [
    'Dashboard empty-state guides — first time you land on each page with no data, get a one-click action instead of a blank list.',
    'Integrations directory — single page listing every alert channel, webhook event, and ingest format, with copy-paste curl examples.',
    'Status page templates — pre-built color/logo combos so you do not need a designer to launch a status page.',
    'Light theme toggle for the dashboard.',
    'Monthly SLA report — auto-generated HTML email summarising uptime per monitor for the previous calendar month.',
    'Distributed trace view — overlay logs on top of check failures so an incident page shows the exact log lines that fired during the down window.',
    'Two-factor auth (TOTP) — recovery codes, settings UI.',
  ],
};

const LATER = {
  title: 'On the list, no committed date',
  items: [
    'White-label / multi-tenant status pages — agencies and resellers ship under their own brand.',
    'Real User Monitoring (RUM) — JavaScript snippet that reports real user load time, errors, and page metrics.',
    'Import incidents from Datadog, Sentry, PagerDuty — central incident hub fed by inbound webhooks.',
    'Browser / synthetic transaction tests — Playwright-driven "log in, click X, assert Y" scripted journeys.',
  ],
};

const DEFERRED = {
  title: 'Deferred (we will not build these soon — be upfront about it)',
  items: [
    {
      name: 'Mobile app (iOS + Android)',
      why: 'A real push-notification-capable mobile app is 6+ months of work. We will not ship one until we have a customer count that justifies it. SMS and voice already work for on-call paging.',
    },
    {
      name: 'SSO / SAML',
      why: 'Required by larger enterprise teams. ~2 weeks of work plus a SOC2 audit they will also want. Currently unfunded.',
    },
    {
      name: 'SOC 2 certification',
      why: 'Process + audit is 4-6 months of wall time and ~$25k. We will start when we have the first signed enterprise contract demanding it, not before.',
    },
  ],
};
---

<Base
  title="Roadmap — 24Observe"
  description="What we are building, what is next, and what we deliberately are not building. Updated 2026-05-27."
>
  <section class="section">
    <div class="container">
      <div class="eyebrow"><span class="bar"></span> Roadmap</div>
      <h1 class="h1">What we are building.</h1>
      <p class="lede" style="margin-top: 24px;">
        Updated <b style="color: var(--ink);">2026-05-28</b>. Engineering source of truth lives in
        <a href="https://github.com/vikasswaminh/observe24/blob/main/ROADMAP.md" target="_blank" rel="noopener">the repo's ROADMAP.md</a>
        — this page is the customer-facing version, with the same priority order.
      </p>
      <p class="lede" style="margin-top: 16px;">
        We are deliberately upfront about what is <b style="color: var(--ink);">not</b> on the list.
        Nothing here is a sales-cycle promise; everything has a concrete code path in the repo with
        LOC and hour estimates.
      </p>
    </div>
  </section>

  <section class="section" id="just-shipped">
    <div class="container">
      <div class="eyebrow">
        <span class="bar"></span>
        <b style="color: var(--ink);">{JUST_SHIPPED.title}</b>
      </div>
      <p class="lede" style="margin-top: 16px;">{JUST_SHIPPED.blurb}</p>
      <div class="why-grid" style="grid-template-columns: 1fr; margin-top: 24px;">
        {JUST_SHIPPED.items.map((item) => (
          <div class="why-card" style="padding: 16px 20px;">
            <div style="font-weight: 600; color: var(--ink); margin-bottom: 6px;">
              <span style="color: var(--accent); margin-right: 8px;">✓</span>{item.name}
            </div>
            <div class="check-body">{item.why}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="now">
    <div class="container">
      <div class="eyebrow">
        <span class="bar"></span>
        <b style="color: var(--ink);">{SHIPPING_NOW.title}</b>
      </div>
      <p class="lede" style="margin-top: 16px;">{SHIPPING_NOW.blurb}</p>
      <div class="why-grid" style="grid-template-columns: 1fr; margin-top: 24px;">
        {SHIPPING_NOW.items.map((item) => (
          <div class="why-card" style="padding: 16px 20px;">
            <div style="font-weight: 600; color: var(--ink); margin-bottom: 6px;">{item.name}</div>
            <div class="check-body">{item.why}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="next">
    <div class="container">
      <div class="eyebrow">
        <span class="bar"></span>
        <b style="color: var(--ink);">{NEXT_UP.title}</b>
      </div>
      <div class="why-grid" style="grid-template-columns: 1fr; margin-top: 24px;">
        {NEXT_UP.items.map((item) => (
          <div class="why-card" style="padding: 16px 20px;">
            <div class="check-body">{item}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="later">
    <div class="container">
      <div class="eyebrow">
        <span class="bar"></span>
        <b style="color: var(--ink);">{LATER.title}</b>
      </div>
      <div class="why-grid" style="grid-template-columns: 1fr; margin-top: 24px;">
        {LATER.items.map((item) => (
          <div class="why-card" style="padding: 16px 20px;">
            <div class="check-body">{item}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="deferred">
    <div class="container">
      <div class="eyebrow">
        <span class="bar"></span>
        <b style="color: var(--ink);">{DEFERRED.title}</b>
      </div>
      <div class="why-grid" style="grid-template-columns: 1fr; margin-top: 24px;">
        {DEFERRED.items.map((item) => (
          <div class="why-card" style="padding: 16px 20px;">
            <div style="font-weight: 600; color: var(--ink); margin-bottom: 6px;">{item.name}</div>
            <div class="check-body">{item.why}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="text-align: center;">
      <p class="lede">
        Found something missing?
        <a href="https://github.com/vikasswaminh/observe24/issues" target="_blank" rel="noopener">Open an issue.</a>
      </p>
    </div>
  </section>
</Base>
